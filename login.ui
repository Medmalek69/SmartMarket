      <property name="styleSheet">
       <string notr="true">
/* ===== Carte glassmorphism ===== */
#carteLogin {
    background-color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 200);
    border-radius: 28px;
}
#SWLogin, #PLoginConnexion, #PLoginInscription {
    background: transparent;
}

/* ===== Textes ===== */
QLabel {
    background: transparent;
    color: #1B2A6B;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 13px;
}
#lblTitreLogin { color: #0F6CB6; font-size: 24px; font-weight: bold; }
#lblBienvenueConnexionLogin, #lblBienvenueInscriptionLogin {
    font-size: 18px; font-weight: 600; margin-bottom: 4px;
}
#lblIdConnexionLogin, #lblMdpConnexionLogin,
#lblIdInscriptionLogin, #lblMdpInscriptionLogin, #lblConfirmationInscriptionLogin {
    font-weight: bold; margin-top: 4px;
}

/* ===== Champs de saisie ===== */
QLineEdit {
    background-color: rgba(255, 255, 255, 235);
    border: 1px solid rgba(15, 108, 182, 60);
    border-radius: 10px;
    padding: 4px 10px;
    color: #1B2A6B;
    font-size: 14px;
}
QLineEdit:hover { border: 1px solid rgba(15, 108, 182, 150); }
QLineEdit:focus { border: 2px solid #0F6CB6; }

/* ===== Boutons principaux (Log in / S'inscrire) ===== */
QPushButton#btnConnexionLogin, QPushButton#btnInscriptionLogin {
    background-color: #0F6CB6;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: bold;
}
QPushButton#btnConnexionLogin:hover, QPushButton#btnInscriptionLogin:hover {
    background-color: #1380D6;
}
QPushButton#btnConnexionLogin:pressed, QPushButton#btnInscriptionLogin:pressed {
    background-color: #0B5590;
}

/* ===== Boutons Face ID ===== */
QPushButton#btnFaceIdConnexionLogin, QPushButton#btnFaceIdInscriptionLogin {
    background-color: rgba(255, 255, 255, 235);
    color: #1B2A6B;
    border: 1px solid rgba(15, 108, 182, 60);
    border-radius: 10px;
    font-size: 14px;
}
QPushButton#btnFaceIdConnexionLogin:hover, QPushButton#btnFaceIdInscriptionLogin:hover {
    background-color: white;
}

/* ===== Liens (changer de page, mot de passe oublié) ===== */
QPushButton#btnVersInscriptionLogin, QPushButton#btnVersConnexionLogin,
QPushButton#btnMdpOublieLogin {
    background: transparent;
    border: none;
    color: #1B2A6B;
    font-size: 13px;
    padding: 4px;
}
QPushButton#btnVersInscriptionLogin:hover, QPushButton#btnVersConnexionLogin:hover {
    color: #0F6CB6;
    text-decoration: underline;
}
QPushButton#btnMdpOublieLogin { color: #D23B3B; font-size: 11px; }
QPushButton#btnMdpOublieLogin:hover { color: #A82020; }
</string>
